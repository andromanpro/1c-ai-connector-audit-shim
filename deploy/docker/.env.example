# --- docker-compose параметры (скопируй в .env и заполни) ---

# Клон upstream-движка rlm-tools-bsl:
#   git clone https://github.com/Dach-Coin/rlm-tools-bsl
# Путь абсолютный или относительный к этому каталогу (deploy/docker).
RLM_REPO=../../../../rlm-tools-bsl

# XML-дамп вашей конфигурации 1С (то, что индексирует rlm и читает аудитор).
# Абсолютный путь на хосте. Внутри контейнера монтируется в /repos/iikona.
AUDIT_DUMP=/absolute/path/to/1c-xml-dump

# Порты, публикуемые на хост:
RLM_PORT=9000
AUDIT_PORT=9001
